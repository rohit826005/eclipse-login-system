<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elililly.auth.ui.LoginController"
      alignment="CENTER" spacing="15"
      style="-fx-background-color: #f0f4f8;">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

    <Label text="Eclipse Login System"
           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <TextField fx:id="usernameField" promptText="Username or Email"
               maxWidth="280" style="-fx-pref-height: 36;"/>

    <PasswordField fx:id="passwordField" promptText="Password"
                   maxWidth="280" style="-fx-pref-height: 36;"/>

    <CheckBox fx:id="rememberMeCheckBox" text="Remember me"/>

    <Button fx:id="loginButton" text="Login"
            onAction="#handleLogin" maxWidth="280"
            style="-fx-pref-height: 36; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14;"/>

    <Label fx:id="messageLabel" wrapText="true" maxWidth="280"/>

    <Separator maxWidth="280"/>

    <HBox alignment="CENTER" spacing="20">
        <Button text="Register" onAction="#handleOpenRegistration"
                style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand;"/>
        <Button text="Forgot Password?" onAction="#handleOpenPasswordRecovery"
                style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand;"/>
    </HBox>
</VBox>
