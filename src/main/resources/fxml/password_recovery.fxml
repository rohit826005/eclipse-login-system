<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elililly.auth.ui.PasswordRecoveryController"
      alignment="CENTER" spacing="15"
      style="-fx-background-color: #f0f4f8;">
    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

    <Label text="Password Recovery"
           style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Enter your username or email and choose a new password."
           wrapText="true" maxWidth="280"
           style="-fx-text-fill: #555;"/>

    <TextField fx:id="usernameOrEmailField" promptText="Username or Email"
               maxWidth="280" style="-fx-pref-height: 36;"/>
    <PasswordField fx:id="newPasswordField" promptText="New Password"
                   maxWidth="280" style="-fx-pref-height: 36;"/>
    <PasswordField fx:id="confirmNewPasswordField" promptText="Confirm New Password"
                   maxWidth="280" style="-fx-pref-height: 36;"/>

    <Label fx:id="messageLabel" wrapText="true" maxWidth="280"/>

    <Button text="Reset Password" onAction="#handleResetPassword" maxWidth="280"
            style="-fx-pref-height: 36; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14;"/>
    <Button text="Cancel" onAction="#handleCancel" maxWidth="280"
            style="-fx-pref-height: 36;"/>
</VBox>
